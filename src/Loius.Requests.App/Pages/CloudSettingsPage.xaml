<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Loius.Requests.App.Pages.CloudSettingsPage"
             Title="Synchronizácia">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Nastavenie synchronizácie" FontAttributes="Bold" FontSize="24" />
            <Label Text="Rolu a oddelenie pridelí iba administrátor v cloude. Pri prvom nastavení zadajte telefónne číslo, ktoré má administrátor uložené pri vašom mene."
                   TextColor="Gray" />
            <Label x:Name="AssignedUserLabel" TextColor="Gray" />
            <Entry x:Name="PhoneNumberEntry" Placeholder="Telefónne číslo" Keyboard="Telephone" />
            <Entry x:Name="EndpointEntry" Placeholder="https://…" Keyboard="Url" />
            <Entry x:Name="AccessKeyEntry" Placeholder="Prístupový kľúč" IsPassword="True" />
            <Button Text="Pripojiť tento telefón" Clicked="Save_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
